{
  "manifest_version": 3,
  "name": "Form Auto-Filler",
  "version": "1.1",
  "description": "Fills form inputs on the current tab using a hardcoded dictionary of element IDs and values.",
  "permissions": ["activeTab", "scripting", "storage", "nativeMessaging"],
  "host_permissions": [
    "https://propdream.ai/*",
    "https://*.s3.amazonaws.com/*",
    "https://*.s3.*.amazonaws.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
